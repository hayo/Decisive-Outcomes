# Decisive Outcomes Group — Apache-configuratie. Zie website/CLAUDE.md.

Options -Indexes -MultiViews
DirectoryIndex index.php index.html
AddDefaultCharset utf-8
AddType application/atom+xml .atom
ServerSignature Off

ErrorDocument 404 /404.php
ErrorDocument 410 /410.php
ErrorDocument 500 /500.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Eén adres: https, zonder www.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://decisiveoutcomes.nl%{REQUEST_URI} [R=301,L,NE]

# AI- en LLM-crawlers weigeren.
RewriteCond %{HTTP_USER_AGENT} (GPTBot|ChatGPT-User|OAI-SearchBot|ClaudeBot|Claude-Web|Claude-User|Claude-SearchBot|anthropic-ai|Google-Extended|Applebot-Extended|CCBot|PerplexityBot|Perplexity-User|Bytespider|Amazonbot|Meta-External|FacebookBot|cohere|Diffbot|ImagesiftBot|Omgili|Timpibot|YouBot|AI2Bot|Ai2Bot|DuckAssistBot|MistralAI|PetalBot|Scrapy) [NC]
RewriteCond %{REQUEST_URI} !^/robots\.txt$
RewriteRule ^ - [F,L]

# Verborgen bestanden en voorbeeldconfiguratie nooit uitleveren.
RewriteRule (^|/)\.(?!well-known/) - [F,L]

# Nooit .php of index.php in een URL: stuur door naar de nette URL.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Altijd een slash aan het eind van een map.
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

# sitemap.xml wordt door PHP gemaakt.
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# --- Redirects (301) en verwijderde pagina's (410) ---
# Formaat: één regel per URL, met een korte reden erboven.
# Voorbeeld, oude naam van de nieuwssectie:
RewriteRule ^nieuws/?$ /inzichten/ [R=301,L]

# --- Routering (na de redirects, zodat een redirect altijd voorgaat) ---
# Persberichten, inzichten, divisies en sectoren hebben geen eigen map: die
# pagina's maakt router.php uit content/ en includes/data.php.
RewriteRule ^newsroom/([a-z0-9-]+/?)?$ router.php [L]
RewriteRule ^inzichten/([a-z]+(/([a-z0-9-]+/?)?)?)?$ router.php [L]
RewriteRule ^(diensten|sectoren)/[a-z0-9-]+/?$ router.php [L]
</IfModule>

<IfModule mod_headers.c>
Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; form-action 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests"
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=(), browsing-topics=()"
Header always set Cross-Origin-Opener-Policy "same-origin"
Header always set X-Frame-Options "DENY"
Header always unset X-Powered-By
Header unset X-Powered-By

# Cache: statische bestanden een jaar (versie via ?v=), HTML kort.
<FilesMatch "\.(css|js|woff2|png|jpg|jpeg|svg|ico|pdf)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(php|html|xml|txt)$">
Header set Cache-Control "public, max-age=300"
</FilesMatch>
</IfModule>

<IfModule mod_brotli.c>
AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/xml application/atom+xml image/svg+xml
</IfModule>
<IfModule !mod_brotli.c>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/xml application/atom+xml image/svg+xml
</IfModule>
</IfModule>

<IfModule mod_mime.c>
AddType font/woff2 .woff2
</IfModule>
